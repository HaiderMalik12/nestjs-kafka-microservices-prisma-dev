// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// AFTER (Standard output - Recommended)
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        // reference to Order service's order ID (no FK across DBs)
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)

  // Optional meta fields
  transactionRef String?    // external gateway reference
  errorMessage   String?    // failure reason if FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔹 Query patterns:
  // - We often look up by orderId (1 payment per order) → make it UNIQUE
  // - We often filter by status (PENDING / SUCCESS / FAILED) → keep an index
  @@unique([orderId])
  @@index([status])
}